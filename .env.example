# Root environment file for Python CLI + RAG service
OPENAI_API_KEY=sk-your-key-here

# Optional RAG service overrides
RAG_MODEL=gpt-4o-mini
RAG_TEMPERATURE=0.1
RAG_MAX_TOKENS=512
RAG_HOST=127.0.0.1
RAG_PORT=8000

# Optional remote evaluator service settings (for agent_eval_lab.runner.service)
EVAL_RUNNER_TOKEN=
SCENARIO_DEFINITIONS_DIR=scenario_definitions
