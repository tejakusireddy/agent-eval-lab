# Database
DATABASE_URL="postgresql://user:password@localhost:5432/agent_eval?schema=public"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# UploadThing
UPLOADTHING_SECRET=sk_live_...
UPLOADTHING_APP_ID=...

# Inngest (Background Jobs)
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# Python CLI Path (for running evaluations)
PYTHON_CLI_PATH=.venv/bin/python
AGENT_EVAL_PATH=../agent_eval_lab

# Optional: Slack alert for blocked release-candidate evaluations
SLACK_WEBHOOK_URL=

# Optional: Jira Automation webhook for signed audit events
JIRA_WEBHOOK_URL=

# Optional: sign audit webhook payloads (Slack/Jira)
# AUDIT_SIGNING_KEY=replace-with-long-random-secret
# AUDIT_SIGNING_KEY_ID=audit-2026-q1

# Optional: sign evidence packs (HMAC-SHA256)
# EVIDENCE_SIGNING_KEY=replace-with-long-random-secret
# EVIDENCE_SIGNING_KEY_ID=key-2026-q1

# RBAC defaults (app-level)
# RBAC_DEFAULT_ROLE=admin
# RBAC_STRICT=false
# RBAC_ADMIN_USER_IDS=user_abc,user_xyz
# RBAC_RELEASE_MANAGER_USER_IDS=user_release_1
# RBAC_EVALUATOR_USER_IDS=user_eval_1
# RBAC_VIEWER_USER_IDS=user_view_1

# Optional: token env var example for custom HTTP agents
# MY_AGENT_API_KEY=
# MOCK_AGENT_API_KEY=dev-mock-agent-key

# Optional: hash salt for platform API keys (set in production)
# API_KEY_HASH_SALT=replace-with-random-hex

# Optional: organization daily evaluation quota
# ORG_DAILY_EVALUATION_LIMIT=50

# Optional: public self-serve mode (allows anonymous exploratory HTTP-agent evals)
# PUBLIC_SELF_SERVE_MODE=false
# PUBLIC_SELF_SERVE_DAILY_LIMIT=3
# PUBLIC_SELF_SERVE_MAX_SCENARIOS=3
# PUBLIC_SELF_SERVE_SALT=replace-with-random-hex

# Optional: remote evaluator service (recommended for Vercel deployment)
# EVAL_RUNNER_URL=https://your-runner-service.example.com/v1/evaluate
# EVAL_RUNNER_TOKEN=replace-with-shared-secret
# EVAL_RUNNER_SCENARIOS_DIR=/app/scenario_definitions
# EVAL_EXECUTION_MODE=inline
